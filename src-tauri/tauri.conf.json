{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "waterfowl",
  "version": "0.2.1",
  "identifier": "com.fosslife.waterfowl",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "waterfowl",
        "width": 1000,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZFMTQ1NjJFRTgxNDEwQTgKUldTb0VCVG9MbFlVL3E4UllmbGh1a005SUNoeHdES1cwZ2piMC9OWnFPWmtXdDladHJYK0JScVcK",
      "endpoints": [
        "https://github.com/fosslife/waterfowl/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
