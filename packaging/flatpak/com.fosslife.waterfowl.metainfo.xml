<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.fosslife.waterfowl</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <name>Waterfowl</name>
  <summary>Desktop PostgreSQL database manager</summary>

  <description>
    <p>
      Waterfowl is a desktop manager for PostgreSQL databases. Save and organize your
      connections, browse schemas, tables, views, functions and sequences, edit data
      inline, and run ad-hoc SQL queries from a CodeMirror-powered editor.
    </p>
  </description>

  <launchable type="desktop-id">com.fosslife.waterfowl.desktop</launchable>

  <url type="homepage">https://github.com/fosslife/waterfowl</url>
  <url type="bugtracker">https://github.com/fosslife/waterfowl/issues</url>
  <url type="vcs-browser">https://github.com/fosslife/waterfowl</url>

  <developer id="com.fosslife">
    <name>Fosslife</name>
  </developer>

  <!-- TODO(Phase 2): replace with a real, reachable screenshot URL — Flathub validation
       requires at least one screenshot that downloads and meets size rules. -->
